+
+/* Ordered time requests across up to sixteen witnessed service PCs.
+ * Each row is (PC, RAM accumulator address, elapsed input), never output state. */
+static uint32_t e9k_clock_sequence[4096][3];
+static uint32_t e9k_clock_sequence_index, e9k_clock_sequence_error;
+static uint32_t e9k_clock_sequence_sites[16], e9k_clock_sequence_site_count;
+E9K_RECOMP_EXPORT int e9k_debug_set_clock_input_sequence(const uint32_t *rows, uint32_t count)
+{
+    if (!e9k_debug_is_paused()) return 0;
+    if (!rows && !count) {
+        e9k_clock_sequence_count = e9k_clock_sequence_index = e9k_clock_sequence_error = 0;
+        e9k_clock_sequence_site_count = 0;
+        return 1;
+    }
+    if (!rows || !count || count > 4096 || e9k_clock_count) return 0;
+    uint32_t sites[16], addresses[16], site_count = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t pc = rows[i * 3], address = rows[i * 3 + 1], site;
+        if ((pc & 1) || pc > 0xffffffu || (address & 1) || address > 0xfffffcu ||
+            bankindex(address) != bankindex(address + 3)) return 0;
+        addrbank *bank = &get_mem_bank(address);
+        if (!(bank->flags & ABFLAG_RAM) || (bank->flags & ABFLAG_IO) ||
+            !bank->check || !bank->check(address, 4)) return 0;
+        for (site = 0; site < site_count && sites[site] != pc; ++site) {}
+        if (site == site_count) {
+            if (site_count == 16) return 0;
+            sites[site_count] = pc;
+            addresses[site_count++] = address;
+        } else if (addresses[site] != address) return 0;
+    }
+    memcpy(e9k_clock_sequence, rows, count * 3 * sizeof(*rows));
+    memcpy(e9k_clock_sequence_sites, sites, site_count * sizeof(*sites));
+    e9k_clock_sequence_site_count = site_count;
+    e9k_clock_sequence_count = count;
+    e9k_clock_sequence_index = e9k_clock_sequence_error = 0;
+    return 1;
+}
+E9K_RECOMP_EXPORT uint32_t e9k_debug_clock_sequence_consumed(void) { return e9k_clock_sequence_index; }
+E9K_RECOMP_EXPORT uint32_t e9k_debug_clock_sequence_error(void) { return e9k_clock_sequence_error; }
+static bool e9k_clock_sequence_step(uint32_t pc)
+{
+    if (!e9k_clock_sequence_count) return true;
+    uint32_t site;
+    for (site = 0; site < e9k_clock_sequence_site_count && e9k_clock_sequence_sites[site] != pc; ++site) {}
+    if (site == e9k_clock_sequence_site_count) return true;
+    if (e9k_clock_sequence_index == e9k_clock_sequence_count) {
+        e9k_clock_sequence_error = 1;
+        return false;
+    }
+    const uint32_t *row = e9k_clock_sequence[e9k_clock_sequence_index];
+    if (row[0] != pc) {
+        e9k_clock_sequence_error = 2;
+        return false;
+    }
+    put_long(row[1], row[2]);
+    e9k_clock_sequence_index++;
+    return true;
 }
 
