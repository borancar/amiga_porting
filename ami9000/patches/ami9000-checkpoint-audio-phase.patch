+#ifdef SAVESTATE
+/* Exact IEEE-754 phase bits; this record does not serialize mixer/filter/FIFO state. */
+static bool audio_checkpoint_phase_values_supported(float next, float scaled)
+{
+    return sizeof(float) == 4 && isfinite(next) && isfinite(scaled) &&
+        next >= 0 && next < 4294967296.0f && scaled > 0 && scaled < 4294967296.0f;
+}
+
+bool audio_checkpoint_phase_supported(void)
+{
+    return audio_checkpoint_phase_values_supported(next_sample_evtime, scaled_sample_evtime) &&
+        last_cycles <= get_cycles() && audio_checkpoint_filter_supported();
+}
+
+bool audio_checkpoint_phase_payload_supported(const uae_u8 *payload)
+{
+    uae_u32 next_bits = ((uae_u32)payload[12] << 24) | ((uae_u32)payload[13] << 16) |
+        ((uae_u32)payload[14] << 8) | payload[15];
+    uae_u32 scaled_bits = ((uae_u32)payload[16] << 24) | ((uae_u32)payload[17] << 16) |
+        ((uae_u32)payload[18] << 8) | payload[19];
+    float next, scaled;
+    if (sizeof(float) != 4) return false;
+    memcpy(&next, &next_bits, 4);
+    memcpy(&scaled, &scaled_bits, 4);
+    return audio_checkpoint_phase_values_supported(next, scaled);
+}
+
+uae_u8 *save_audio_checkpoint_phase(size_t *len, uae_u8 *dstptr)
+{
+    uae_u8 *dstbak = dstptr ? dstptr : xmalloc(uae_u8, 20);
+    uae_u8 *dst = dstbak;
+    uae_u32 next_bits, scaled_bits;
+    memcpy(&next_bits, &next_sample_evtime, 4);
+    memcpy(&scaled_bits, &scaled_sample_evtime, 4);
+    save_u32(1);
+    save_u64(last_cycles);
+    save_u32(next_bits);
+    save_u32(scaled_bits);
+    *len = dst - dstbak;
+    return dstbak;
+}
+
+uae_u8 *restore_audio_checkpoint_phase(uae_u8 *src)
+{
+    checkpoint_audio_phase_valid = false;
+    if (restore_u32() != 1) return src;
+    checkpoint_audio_last_cycles = restore_u64();
+    uae_u32 bits = restore_u32();
+    memcpy(&checkpoint_audio_next_sample, &bits, 4);
+    bits = restore_u32();
+    memcpy(&checkpoint_audio_scaled_sample, &bits, 4);
+    checkpoint_audio_phase_valid = true;
+    return src;
+}
+
+bool audio_checkpoint_phase_finish(void)
+{
+    if (!checkpoint_audio_phase_valid || checkpoint_audio_last_cycles > get_cycles() ||
+        !audio_checkpoint_phase_values_supported(checkpoint_audio_next_sample, checkpoint_audio_scaled_sample))
+        return false;
+    last_cycles = checkpoint_audio_last_cycles;
+    next_sample_evtime = checkpoint_audio_next_sample;
+    scaled_sample_evtime = checkpoint_audio_scaled_sample;
+    checkpoint_audio_phase_valid = false;
+    return true;
+}
+#endif
+
+#ifdef SAVESTATE
+bool audio_checkpoint_filter_supported(void)
+{
+    if (sizeof(float) != 4 || sizeof(sound_filter_state) != 80) return false;
+    float values[20];
+    memcpy(values, sound_filter_state, 80);
+    for (int i = 0; i < 20; ++i) if (!isfinite(values[i])) return false;
+    return true;
+}
+
+bool audio_checkpoint_filter_payload_supported(const uae_u8 *payload)
+{
+    if (sizeof(float) != 4) return false;
+    for (int i = 0; i < 20; ++i) {
+        const uae_u8 *p = payload + 4 + 4 * i;
+        uae_u32 bits = ((uae_u32)p[0] << 24) | ((uae_u32)p[1] << 16) | ((uae_u32)p[2] << 8) | p[3];
+        float value;
+        memcpy(&value, &bits, 4);
+        if (!isfinite(value)) return false;
+    }
+    return true;
+}
+
+uae_u8 *save_audio_checkpoint_filter(size_t *len, uae_u8 *dstptr)
+{
+    uae_u8 *dstbak = dstptr ? dstptr : xmalloc(uae_u8, 84);
+    uae_u8 *dst = dstbak;
+    float values[20];
+    memcpy(values, sound_filter_state, 80);
+    save_u32(1);
+    for (int i = 0; i < 20; ++i) {
+        uae_u32 bits;
+        memcpy(&bits, &values[i], 4);
+        save_u32(bits);
+    }
+    *len = dst - dstbak;
+    return dstbak;
+}
+
+uae_u8 *restore_audio_checkpoint_filter(uae_u8 *src)
+{
+    checkpoint_audio_filter_valid = false;
+    if (restore_u32() != 1) return src;
+    for (int i = 0; i < 20; ++i) {
+        uae_u32 bits = restore_u32();
+        memcpy(&checkpoint_audio_filter[i], &bits, 4);
+    }
+    checkpoint_audio_filter_valid = true;
+    return src;
+}
+
+bool audio_checkpoint_filter_finish(void)
+{
+    if (!checkpoint_audio_filter_valid || sizeof(sound_filter_state) != 80) return false;
+    for (int i = 0; i < 20; ++i) if (!isfinite(checkpoint_audio_filter[i])) return false;
+    memcpy(sound_filter_state, checkpoint_audio_filter, 80);
+    checkpoint_audio_filter_valid = false;
+    return true;
+}
+#endif
