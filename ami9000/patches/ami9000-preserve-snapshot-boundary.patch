+/* Exact debug restore supports the core's uncompressed 68000 machine prefix.
+ * Legacy type-0 events are irrecoverable, not inferred from their data. */
+RETRO_API bool e9k_debug_unserialize_at_saved_pc(const void *data, size_t size)
+{
+    const uint8_t *bytes = (const uint8_t *)data;
+    size_t offset = 0;
+    bool cpu_seen = false, ended = false;
+    uint32_t expected_pc = 0;
+    if (!data || size < 12 || memcmp(bytes, "ASF ", 4))
+        return false;
+    while (offset <= size - 8) {
+        const uint8_t *chunk = bytes + offset;
+        uint32_t length = e9k_snapshot_be32(chunk + 4);
+        if (!memcmp(chunk, "\0\0\0\0", 4)) { offset += 4; continue; }
+        if (!memcmp(chunk, "END ", 4)) { ended = length == 8; break; }
+        if (length < 12 || length > size - offset || e9k_snapshot_be32(chunk + 8) != 0)
+            return false;
+        const uint8_t *payload = chunk + 12;
+        uint32_t payload_size = length - 12;
+        if (!memcmp(chunk, "CPU ", 4)) {
+            if (cpu_seen || payload_size != 156 || e9k_snapshot_be32(payload) != 68000)
+                return false;
+            expected_pc = e9k_snapshot_be32(payload + 68);
+            cpu_seen = true;
+        }
+        if (!memcmp(chunk, "CHPD", 4)) {
+            if (payload_size < 5 || e9k_snapshot_be32(payload) != 1 || payload_size != 5u + payload[4] * 13u)
+                return false;
+            for (unsigned int i = 0; i < payload[4]; ++i)
+                if (!custom_event_delay_type_supported(payload[5 + i * 13]))
+                    return false;
+        }
+        offset += ((size_t)length + 3) & ~(size_t)3;
+    }
+    if (!ended || !cpu_seen || savestate_state)
+        return false;
+    libretro_restore_exact = true;
+    bool ok = retro_unserialize(data, size);
+    libretro_restore_exact = false;
+    uint32_t registers[18];
+    return ok && !savestate_state && e9k_debug_is_paused() &&
+        e9k_debug_read_regs(registers, 18) == 18 && registers[17] == expected_pc;
+}
