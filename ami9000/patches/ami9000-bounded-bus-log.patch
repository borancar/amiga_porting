+    row->pc = regs.instruction_pc;
+    row->address = address;
+    row->value = 0;
+    row->kind = kind;
+    row->mode = mode;
+    row->hpos = current_hpos_safe();
+    row->vpos = vpos;
+    row->requested = requested;
+    return row;
+}
