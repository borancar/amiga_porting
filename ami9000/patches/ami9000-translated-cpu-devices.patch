+#endif
+static arecomp_original_execute e9k_recomp_executor;
+static bool e9k_recomp_active;
+static uint32_t e9k_recomp_bus_clocks;
+
+E9K_RECOMP_EXPORT int e9k_recomp_set_executor(uint32_t abi, arecomp_original_execute executor)
+{
+    if (abi != ARECOMP_ORIGINAL_DEVICES_ABI || e9k_recomp_active || !e9k_debug_is_paused())
+        return 0;
+    if (executor && (currprefs.cpu_model != 68000 || !currprefs.cpu_cycle_exact || cpu_tracer))
+        return 0;
+    e9k_recomp_executor = executor;
+    return 1;
+}
+
+E9K_RECOMP_EXPORT uint32_t e9k_recomp_read(uint32_t address, uint32_t bits)
+{
+    if (!e9k_recomp_active) return 0xffffffffu;
+    address &= 0x00ffffffu;
+    if (bits == ARECOMP_ORIGINAL_INSPECT_BYTE) return get_byte_debug(address);
+    if (bits == 8) { e9k_recomp_bus_clocks += 4; return x_get_byte(address); }
+    if (bits == 16) { e9k_recomp_bus_clocks += 4; return x_get_word(address); }
+    if (bits == 32) { e9k_recomp_bus_clocks += 8; return x_get_long(address); }
+    return 0xffffffffu;
+}
+
+E9K_RECOMP_EXPORT void e9k_recomp_write(uint32_t address, uint32_t value, uint32_t bits)
+{
+    if (!e9k_recomp_active) return;
+    address &= 0x00ffffffu;
+    if (bits == 8) { e9k_recomp_bus_clocks += 4; x_put_byte(address, value); }
+    else if (bits == 16) { e9k_recomp_bus_clocks += 4; x_put_word(address, value); }
+    else if (bits == 32) { e9k_recomp_bus_clocks += 8; x_put_long(address, value); }
+}
+
+/* Original core owns RAM/devices. Callback owns exactly this instruction.
+ * Original CE bus accesses plus remaining nominal internal clocks are development semantics;
+ * frame comparison must qualify them. No original instruction fallback.
+ */
+static bool e9k_recomp_instruction(void)
+{
+    arecomp_original_cpu cpu;
+    int result;
+    uint32_t previous_pc = m68k_getpc();
+    MakeSR();
+    memcpy(cpu.regs, regs.regs, sizeof(cpu.regs));
+    cpu.pc = m68k_getpc();
+    cpu.sr = regs.sr;
+    cpu.usp = regs.usp;
+    cpu.ssp = regs.isp;
+    cpu.cycles = 0;
+    cpu.stopped = 0;
+    cpu.length = 0;
+    e9k_recomp_bus_clocks = 0;
+    e9k_recomp_active = true;
+    result = e9k_recomp_executor(&cpu);
+    e9k_recomp_active = false;
+    if (result != 1 || cpu.cycles < 1 || cpu.cycles > 4096 || (cpu.pc & 1) || cpu.pc > 0xffffffu ||
+        cpu.length < 2 || cpu.length > 10 || (cpu.length & 1)) {
+        e9k_debug_pause();
+        return false;
+    }
+    /* MakeFromSR may swap stacks; install the callback's final registers AFTER it. */
+    regs.sr = cpu.sr;
+    MakeFromSR();
+    memcpy(regs.regs, cpu.regs, sizeof(cpu.regs));
+    regs.usp = cpu.usp;
+    regs.isp = cpu.ssp;
+    m68k_setpc(cpu.stopped ? previous_pc : cpu.pc);
+    if (!cpu.stopped) {
+        /* Straight-line execution consumes each extension and one refill word.
+         * A redirected PC refills both prefetch words. Bus helpers retain DMA
+         * contention; subtract only nominal bus clocks from the CPU estimate.
+         * Access ordering within an instruction remains a development limit.
+         */
+        uint32_t words = cpu.pc == ((previous_pc + cpu.length) & 0xffffffu) ? cpu.length / 2 : 2;
+        uint32_t address = words == cpu.length / 2 && cpu.pc == ((previous_pc + cpu.length) & 0xffffffu)
+            ? previous_pc + 4 : cpu.pc;
+        for (uint32_t i = 0; i < words; ++i) {
+            regs.irc = x_get_word((address + i * 2) & 0xffffffu);
+            e9k_recomp_bus_clocks += 4;
+        }
+        regs.ir = get_word_debug(cpu.pc);
+    }
+    if (cpu.cycles > e9k_recomp_bus_clocks)
+        x_do_cycles((cpu.cycles - e9k_recomp_bus_clocks) * (CYCLE_UNIT / 2));
+    ipl_fetch_now();
+    if (cpu.stopped) m68k_setstopped(1);
+    return true;
+}
