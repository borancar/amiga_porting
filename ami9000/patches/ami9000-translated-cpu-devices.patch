--- /dev/null
+++ b/ami9000/libretro/e9k_recomp.h
@@ -0,0 +1,28 @@
+/* Versioned C ABI for translated CPU execution with original UAE devices.
+ * A successful callback executes exactly one instruction. Missing/changed code
+ * must return -1: the core pauses without executing its original CPU handler.
+ * Memory callbacks are valid only during execute(), on the core's thread.
+ */
+#ifndef ARECOMP_ORIGINAL_DEVICES_H
+#define ARECOMP_ORIGINAL_DEVICES_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define ARECOMP_ORIGINAL_DEVICES_ABI 2u
+/* Inspection reads validate code bytes without issuing a guest bus access. */
+#define ARECOMP_ORIGINAL_INSPECT_BYTE 0x108u
+typedef struct arecomp_original_cpu {
+    uint32_t regs[16];
+    uint32_t pc, sr, usp, ssp;
+    uint32_t cycles; /* output: nominal CPU clocks for this instruction */
+    uint32_t stopped;
+    uint32_t length; /* output: bytes in the translated instruction */
+} arecomp_original_cpu;
+typedef int (*arecomp_original_execute)(arecomp_original_cpu *cpu);
+typedef uint32_t (*arecomp_original_read)(uint32_t address, uint32_t bits);
+typedef void (*arecomp_original_write)(uint32_t address, uint32_t value, uint32_t bits);
+#ifdef __cplusplus
+}
+#endif
+#endif
