+/* Pending frontend work can alter guest beam timing on a later retro_run. */
+static struct {
+    bool valid;
+    uint8_t timer, reset, update, old_frame;
+    uint32_t changed, changed_flags;
+} libretro_av_checkpoint;
+
+void libretro_av_checkpoint_clear(void)
+{
+    libretro_av_checkpoint.valid = false;
+}
+
+uae_u8 *save_libretro_av_checkpoint(size_t *len, uae_u8 *dstptr)
+{
+    uae_u8 *dstbak = dstptr ? dstptr : xmalloc(uae_u8, 16);
+    uae_u8 *dst = dstbak;
+    save_u32(1);
+    save_u8(request_init_custom_timer);
+    save_u8(request_reset_drawing ? 1 : 0);
+    save_u8(request_update_av_info ? 1 : 0);
+    save_u8(libretro_old_frame);
+    save_u32((uae_u32)config_changed);
+    save_u32((uae_u32)config_changed_flags);
+    *len = dst - dstbak;
+    return dstbak;
+}
+
+uae_u8 *restore_libretro_av_checkpoint(uae_u8 *src)
+{
+    libretro_av_checkpoint.valid = false;
+    if (restore_u32() != 1) return src;
+    libretro_av_checkpoint.timer = restore_u8();
+    libretro_av_checkpoint.reset = restore_u8();
+    libretro_av_checkpoint.update = restore_u8();
+    libretro_av_checkpoint.old_frame = restore_u8();
+    libretro_av_checkpoint.changed = restore_u32();
+    libretro_av_checkpoint.changed_flags = restore_u32();
+    libretro_av_checkpoint.valid = true;
+    return src;
+}
+
+bool libretro_av_checkpoint_finish(void)
+{
+    if (!libretro_av_checkpoint.valid) return false;
+    request_init_custom_timer = libretro_av_checkpoint.timer;
+    request_reset_drawing = libretro_av_checkpoint.reset != 0;
+    request_update_av_info = libretro_av_checkpoint.update != 0;
+    libretro_old_frame = libretro_av_checkpoint.old_frame;
+    config_changed = (uae_s32)libretro_av_checkpoint.changed;
+    config_changed_flags = (uae_s32)libretro_av_checkpoint.changed_flags;
+    libretro_av_checkpoint.valid = false;
+    return true;
+}
