+    vb_start_line = checkpoint_vblank.start_line;
+    bogusframe = checkpoint_vblank.bogus;
+    maxvpos_display_vsync = checkpoint_vblank.display_vsync;
+    for (int i = 0; i < 11; ++i) *flags[i] = checkpoint_vblank.flags[i];
+    checkpoint_vblank.valid = false;
+    return true;
+}
