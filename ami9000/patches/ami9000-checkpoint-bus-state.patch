+#ifdef SAVESTATE
+uae_u8 *save_custom_checkpoint_bus(size_t *len, uae_u8 *dstptr)
+{
+    uae_u8 *dstbak = dstptr ? dstptr : xmalloc(uae_u8, 849);
+    uae_u8 *dst = dstbak;
+    const int counters[6] = {extra_cycle, line_cyclebased, last_decide_line_hpos,
+        last_fetch_hpos, last_decide_sprite_hpos, last_copper_hpos};
+    save_u32(1);
+    save_u32(272);
+    for (int i = 0; i < 272; ++i) save_u8(cycle_line_slot[i]);
+    for (int i = 0; i < 272; ++i) save_u16(cycle_line_pipe[i]);
+    save_u8(cycle_line_slot_last);
+    for (int i = 0; i < 6; ++i) save_u32((uae_u32)counters[i]);
+    *len = dst - dstbak;
+    return dstbak;
+}
+
+uae_u8 *restore_custom_checkpoint_bus(uae_u8 *src)
+{
+    checkpoint_bus.valid = false;
+    if (restore_u32() != 1 || restore_u32() != 272) return src;
+    for (int i = 0; i < 272; ++i) checkpoint_bus.slots[i] = restore_u8();
+    for (int i = 0; i < 272; ++i) checkpoint_bus.pipe[i] = restore_u16();
+    checkpoint_bus.last = restore_u8();
+    for (int i = 0; i < 6; ++i) checkpoint_bus.counters[i] = (uae_s32)restore_u32();
+    checkpoint_bus.valid = true;
+    return src;
+}
+
+bool custom_checkpoint_bus_finish(void)
+{
+    if (!checkpoint_bus.valid) return false;
+    int *counters[6] = {&extra_cycle, &line_cyclebased, &last_decide_line_hpos,
+        &last_fetch_hpos, &last_decide_sprite_hpos, &last_copper_hpos};
+    memcpy(cycle_line_slot, checkpoint_bus.slots, sizeof(checkpoint_bus.slots));
+    memcpy(cycle_line_pipe, checkpoint_bus.pipe, sizeof(checkpoint_bus.pipe));
+    cycle_line_slot_last = checkpoint_bus.last;
+    for (int i = 0; i < 6; ++i) *counters[i] = checkpoint_bus.counters[i];
+    checkpoint_bus.valid = false;
+    return true;
+}
+#endif
