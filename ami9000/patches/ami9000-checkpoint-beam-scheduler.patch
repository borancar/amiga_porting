+/* Versioned diagnostic beam/primary-scheduler checkpoint. This is not a
+ * complete chipset checkpoint: display/DMA pipeline ownership is separate. */
+static struct {
+    bool valid;
+    uae_s32 beam[12];
+    evt_t line_start, vsync, cycle, next;
+    struct ev primary[ev_max];
+} checkpoint_timing;
+
 void restore_custom_start(void)
 {
+    checkpoint_timing.valid = false;
 	memset(&cop_state, 0, sizeof(cop_state));
 	cop_state.state = COP_stop;
 }
@@ -17817,3 +17827,76 @@
 	decide_line(hpos);
 	decide_fetch_safe(hpos);
 }
+
+#ifdef SAVESTATE
+bool custom_checkpoint_timing_supported(void)
+{
+    const evfunc handlers[ev_max] = {
+        CIA_handler, hsync_handler, hsync_handlerh, MISC_handler, audio_evhandler2
+    };
+    for (int i = 0; i < ev_max; ++i)
+        if (eventtab[i].handler != handlers[i]) return false;
+    return true;
+}
+
+uae_u8 *save_custom_checkpoint_timing(size_t *len, uae_u8 *dstptr)
+{
+    uae_u8 *dstbak = dstptr ? dstptr : xmalloc(uae_u8, 169);
+    uae_u8 *dst = dstbak;
+    const int beam[12] = {vpos, vpos_prev, vposh, linear_vpos,
+        vpos_count, vpos_count_diff, lof_store, lof_display, lol, lol_prev,
+        maxhpos, maxvpos};
+    save_u32(1);
+    for (int i = 0; i < 12; ++i) save_u32((uae_u32)beam[i]);
+    save_u64(line_start_cycles);
+    save_u64(vsync_cycles);
+    save_u64(get_cycles());
+    save_u64(nextevent);
+    for (int i = 0; i < ev_max; ++i) {
+        save_u8(eventtab[i].active ? 1 : 0);
+        save_u64(eventtab[i].evtime);
+        save_u64(eventtab[i].oldcycles);
+    }
+    *len = dst - dstbak;
+    return dstbak;
+}
+
+uae_u8 *restore_custom_checkpoint_timing(uae_u8 *src)
+{
+    checkpoint_timing.valid = false;
+    if (restore_u32() != 1) return src;
+    for (int i = 0; i < 12; ++i) checkpoint_timing.beam[i] = (uae_s32)restore_u32();
+    checkpoint_timing.line_start = restore_u64();
+    checkpoint_timing.vsync = restore_u64();
+    checkpoint_timing.cycle = restore_u64();
+    checkpoint_timing.next = restore_u64();
+    for (int i = 0; i < ev_max; ++i) {
+        checkpoint_timing.primary[i].active = restore_u8() != 0;
+        checkpoint_timing.primary[i].evtime = restore_u64();
+        checkpoint_timing.primary[i].oldcycles = restore_u64();
+    }
+    checkpoint_timing.valid = true;
+    return src;
+}
+
+bool custom_checkpoint_timing_finish(void)
+{
+    if (!checkpoint_timing.valid || !custom_checkpoint_timing_supported() ||
+        checkpoint_timing.cycle != get_cycles() ||
+        checkpoint_timing.beam[10] != maxhpos || checkpoint_timing.beam[11] != maxvpos)
+        return false;
+    int *beam[10] = {&vpos, &vpos_prev, &vposh, &linear_vpos,
+        &vpos_count, &vpos_count_diff, &lof_store, &lof_display, &lol, &lol_prev};
+    for (int i = 0; i < 10; ++i) *beam[i] = checkpoint_timing.beam[i];
+    line_start_cycles = checkpoint_timing.line_start;
+    vsync_cycles = checkpoint_timing.vsync;
+    for (int i = 0; i < ev_max; ++i) {
+        eventtab[i].active = checkpoint_timing.primary[i].active;
+        eventtab[i].evtime = checkpoint_timing.primary[i].evtime;
+        eventtab[i].oldcycles = checkpoint_timing.primary[i].oldcycles;
+    }
+    nextevent = checkpoint_timing.next;
+    checkpoint_timing.valid = false;
+    return true;
+}
+#endif
